  var COUNTRIES = ['uk', 'usa', 'france', 'germany', 'uae', 'canada', 'other'];
  var STORAGE_KEY = 'tenant_rules_country';

  var select = document.getElementById('rulesCountrySelect');
  var detectBtn = document.getElementById('rulesDetectBtn');
  var status = document.getElementById('rulesStatus');
  var panels = document.querySelectorAll('.rules-panel');

  function show(country) {
    var match = COUNTRIES.indexOf(country) !== -1 ? country : 'other';
    panels.forEach(function (p) {
      p.classList.toggle('is-active', p.getAttribute('data-country') === match);
    });
    select.value = match;
  }

  function setStatus(text, isNote) {
    status.textContent = text || '';
    status.classList.toggle('is-note', !!isNote);
  }

  // ISO 3166-1 alpha-2 -> our bucket. Everything else falls back to "other".
  function bucketFromIso(iso) {
    if (!iso) return 'other';
    switch (iso.toUpperCase()) {
      case 'GB': return 'uk';
      case 'US': return 'usa';
      case 'FR': return 'france';
      case 'DE': return 'germany';
      case 'AE': return 'uae';
      case 'CA': return 'canada';
      default: return 'other';
    }
  }

  function remember(country) {
    try { window.localStorage.setItem(STORAGE_KEY, country); } catch (e) { /* storage blocked, fine */ }
  }
  function recall() {
    try { return window.localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
  }

  select.addEventListener('change', function () {
    show(select.value);
    remember(select.value);
    setStatus('');
  });

  // ---- "Use my location" -> browser geolocation + OpenStreetMap reverse geocode ----
  detectBtn.addEventListener('click', function () {
    if (!('geolocation' in navigator)) {
      setStatus("Your browser doesn't support location detection — pick your country above.", true);
      return;
    }
    setStatus('Finding your location…');
    navigator.geolocation.getCurrentPosition(
      function (pos) {
        var lat = pos.coords.latitude, lon = pos.coords.longitude;
        fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lon + '&zoom=3')
          .then(function (res) { if (!res.ok) throw new Error('reverse geocode failed'); return res.json(); })
          .then(function (data) {
            var iso = data && data.address && data.address.country_code;
            var country = bucketFromIso(iso);
            show(country);
            remember(country);
            setStatus(data && data.address && data.address.country ? 'Showing rules for ' + data.address.country + '.' : 'Showing your closest match.', true);
          })
          .catch(function () {
            setStatus("Couldn't work out your country from that — pick one above.", true);
          });
      },
      function () {
        setStatus('Location permission was declined — pick your country above.', true);
      },
      { timeout: 8000 }
    );
  });

  // ---- Silent best-guess on load: saved choice, else a quick IP lookup, else UK default ----
  var saved = recall();
  if (saved) {
    show(saved);
  } else {
    show('uk'); // sensible default while the IP lookup (if any) resolves
    var controller = ('AbortController' in window) ? new AbortController() : null;
    var timeoutId = controller ? setTimeout(function () { controller.abort(); }, 4000) : null;
    fetch('https://ipapi.co/json/', controller ? { signal: controller.signal } : undefined)
      .then(function (res) { if (!res.ok) throw new Error('ip lookup failed'); return res.json(); })
      .then(function (data) {
        if (timeoutId) clearTimeout(timeoutId);
        var country = bucketFromIso(data && data.country_code);
        show(country);
        setStatus('Guessed from your location — change it above if that is wrong.', true);
      })
      .catch(function () {
        if (timeoutId) clearTimeout(timeoutId);
        // Silent fallback: UK default stays, no error shown for an unprompted guess.
      });
  }
})();
</script>

